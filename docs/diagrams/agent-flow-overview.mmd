---
title: Agent roles and the channel files between them
---
flowchart LR
    classDef human fill:#fff3cd,stroke:#8a6d3b,color:#000
    classDef role fill:#d9edf7,stroke:#31708f,color:#000
    classDef channel fill:#dff0d8,stroke:#3c763d,color:#000

    HUMAN["Human<br/>picks the work, reviews, commits"]:::human

    ARCH["Architect"]:::role
    TW["Task writer"]:::role
    CODER["Coder"]:::role
    MR["Milestone Reviewer"]:::role
    HELP["Helper"]:::role

    TASK[".claude/task.md<br/>the one task being worked now"]:::channel
    PROB[".claude/problems.md<br/>the problems that are still open"]:::channel
    ADR["docs/adr/**<br/>decisions that outlive the working tree"]:::channel
    ROADMAP["docs/ROADMAP.md<br/>the whole project, milestone by milestone"]:::channel
    ARCHIVE["docs/tasks/**<br/>the only durable copy of a task"]:::channel

    HUMAN --> ARCH
    HUMAN --> TW
    HUMAN --> CODER
    HUMAN --> MR
    HUMAN --> HELP

    ARCH -- "findings with their evidence;<br/>deletes only its own, once settled<br/>or once it has written the task" --> PROB
    ARCH -- "conclusions that must survive" --> ADR
    ARCH -- "CLAUDE.md, entry prose, agent files" --> ROADMAP
    ARCH -- "writes the task for its own entries" --> TASK

    PROB -- "read first: open entries outrank<br/>new milestone work, except<br/>Architect-signed ones, which the<br/>Task writer never touches" --> TW
    TW -- "deletes each entry it schedules" --> PROB
    ROADMAP -- "read second" --> TW
    TW -- writes --> TASK
    TW -- "archives the finished task" --> ARCHIVE
    TW -- "sets 🚧" --> ROADMAP

    TASK -- "the Coder's only inbox" --> CODER
    CODER -- "subtask Status: lines only" --> TASK
    CODER -- "incidental findings, appended only" --> PROB
    CODER -- "source, tests, sibling .MD;<br/>stops at 👀 Review" --> HUMAN

    HUMAN -- "reviews the subtask, sets ✅ Done,<br/>commits; defects go back as entries" --> PROB
    MR -- "defects and open questions" --> PROB
    MR -- "sets ✅ Done" --> ROADMAP

    PROB -- read --> ARCH
    HELP -- "answers, or names the right role" --> HUMAN