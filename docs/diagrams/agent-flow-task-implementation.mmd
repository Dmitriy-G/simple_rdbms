---
title: Task implementation
---
flowchart TD
    classDef human fill:#fff3cd,stroke:#8a6d3b,color:#000
    classDef role fill:#d9edf7,stroke:#31708f,color:#000
    classDef channel fill:#dff0d8,stroke:#3c763d,color:#000
    classDef gate fill:#f2dede,stroke:#a94442,color:#000
    classDef stop fill:#eeeeee,stroke:#777,color:#000

    START(["'do next task'"]):::human
    CODER["Coder reads .claude/task.MD"]:::role
    PICK["Take the first subtask in the Order Plan<br/>not already marked done.<br/>No Order Plan means the file is one task"]

    SANE{"Is the subtask right, possible,<br/>and consistent with the codebase?"}
    BAD["Append the contradiction to<br/>.claude/problems.MD and stop.<br/>Do not improvise a different task"]:::stop
    BIG{"Does it need a large investigation —<br/>testing a hypothesis, reading half the tree?"}
    ASK["Stop and say so.<br/>That is Architect work"]:::stop

    IMPL["Implement, inside this subtask's scope only:<br/>source, tests in tests/,<br/>a sibling .MD for every .rs including tests,<br/>no comments in .rs,<br/>no allow or expect attributes in source"]
    SIDE{"Noticed something real<br/>but out of scope?"}
    PROB[".claude/problems.MD<br/>numbered title + full description"]:::channel

    GATE["Run the full gate:<br/>cargo build --workspace<br/>cargo fmt --all -- --check<br/>cargo clippy --workspace --all-targets -- -D warnings<br/>bash scripts/check_docs.sh<br/>cargo test --workspace"]:::gate
    TOUCHED{"Did the change touch storage, WAL,<br/>recovery or the double-write buffer?"}
    CRASH["Also run both crash-injection harnesses;<br/>sweep results must be unchanged"]:::gate
    PASS{"All green?"}
    FIX["Fix it — still inside this subtask"]

    STOPHERE["Stop. Do not start the next subtask,<br/>do not commit, leave the tree for review"]:::stop
    CR(["Code Reviewer<br/>— see agent-flow-code-review.mmd"]):::stop

    START --> CODER --> PICK --> SANE
    SANE -- no --> BAD
    SANE -- yes --> BIG
    BIG -- yes --> ASK
    BIG -- no --> IMPL
    IMPL --> SIDE
    SIDE -- yes --> PROB --> GATE
    SIDE -- no --> GATE
    GATE --> TOUCHED
    TOUCHED -- yes --> CRASH --> PASS
    TOUCHED -- no --> PASS
    PASS -- no --> FIX --> GATE
    PASS -- yes --> STOPHERE --> CR