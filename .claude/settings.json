{
  "agent": "helper",
  "permissions": {
    "allow": [
      "Read(//**/.cargo/registry/src/**)",
      "Read(//**/.cargo/git/checkouts/**)",
      "Read(//**/.rustup/toolchains/**)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "Bash(bash scripts/check_docs.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)"
    ]
  }
}
